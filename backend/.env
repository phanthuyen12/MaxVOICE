# Cổng HTTP của Backend API
PORT=8000

# Bảo mật API (Để trống nếu chạy nội bộ không cần key, hoặc đặt chuỗi bí mật để yêu cầu header X-API-Key)
MAXVOICE_API_KEY=

# Cấu hình Faster-Whisper (tiny, base, small, medium, large-v3)
MAXVOICE_WHISPER_MODEL=small
MAXVOICE_WHISPER_DEVICE=cpu
MAXVOICE_WHISPER_COMPUTE_TYPE=int8

# Cấu hình TTS ("vieneu" dùng miễn phí + 28 giọng đa ngôn ngữ, hoặc "resona")
MAXVOICE_TTS_BACKEND=vieneu
RESONA_API_KEY=

# Độ dài mỗi đoạn cắt video (giây) & số luồng worker
MAXVOICE_SEGMENT_SECONDS=60
MAXVOICE_WORKER_THREADS=2

