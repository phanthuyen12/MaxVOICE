# Bản Siêu Nhẹ (Light Mode) cho VPS cấu hình thấp (1GB - 2GB RAM):
# Chỉ cài FastAPI + Redis Queue + Edge-TTS (59 giọng Neural Việt, Nga, Anh, Nhật, Hàn, Trung...) + FFmpeg + Dịch thuật
# Không cài model nặng (VieNeu ONNX / Faster-Whisper), build chỉ mất ~30 giây, ngốn ~150MB RAM!
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MAXVOICE_DATA_DIR=/data \
    MAXVOICE_STORAGE_DIR=/data/storage \
    PORT=8686

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    fonts-noto-core \
    fonts-noto-cjk \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
      "fastapi>=0.111.0" \
      "uvicorn[standard]>=0.30.0" \
      "python-multipart>=0.0.9" \
      "pydantic>=2.7.0" \
      "requests>=2.31.0" \
      "redis>=5.0.0" \
      "numpy>=1.26.0" \
      "soundfile>=0.12.1" \
      "edge-tts>=6.1.12"

COPY app /app/app
COPY run_server.py /app/run_server.py

RUN mkdir -p /data/storage/uploads /data/storage/outputs

EXPOSE 8686

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8686/health || exit 1

CMD ["uvicorn", "app.server:app", "--host", "0.0.0.0", "--port", "8686"]
