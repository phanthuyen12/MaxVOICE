# Cổng HTTP riêng biệt của KingVoice Backend API & Dashboard
PORT=8686

# Hàng đợi Redis (Tự động kết nối Redis trong Docker, hoặc fallback sang Memory nếu chạy lẻ không có Redis)
REDIS_URL=redis://localhost:6379/0

# Thời gian lưu trữ file & task tự động dọn dẹp (Mặc định: 2 giờ xóa 1 lần để nhẹ ổ cứng VPS)
KINGVOICE_RETENTION_HOURS=2
KINGVOICE_CLEANUP_INTERVAL_S=300

# Bảo mật API Key (true = yêu cầu X-API-Key cho các hệ thống bên ngoài gọi vào)
KINGVOICE_REQUIRE_API_KEY=true

# Cấu hình Faster-Whisper (tiny, base, small, medium, large-v3)
MAXVOICE_WHISPER_MODEL=small
MAXVOICE_WHISPER_DEVICE=cpu
MAXVOICE_WHISPER_COMPUTE_TYPE=int8

# Cấu hình TTS ("vieneu" dùng miễn phí + 59 giọng Neural đa ngôn ngữ, hoặc "resona")
MAXVOICE_TTS_BACKEND=vieneu
RESONA_API_KEY=

# Độ dài mỗi đoạn cắt video (giây) & số luồng worker
MAXVOICE_SEGMENT_SECONDS=60
MAXVOICE_WORKER_THREADS=2
